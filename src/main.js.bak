import * as THREE from 'three';

// ----- BASIC THREE.js SETUP -----
const canvas = document.querySelector('#three-canvas');
if (!canvas) { console.error('Canvas #three-canvas not found'); const scene = new THREE.Scene(); const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000); const renderer = new THREE.WebGLRenderer({ canvas, antialias: true }); renderer.setSize(window.innerWidth, window.innerHeight); renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); const ambientLight = new THREE.AmbientLight(0xffffff, 0.6); scene.add(ambientLight); const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8); directionalLight.position.set(50, 100, 50); directionalLight.castShadow = true; scene.add(directionalLight); const sun = new THREE.Object3D(); sun.position.set(50, 50, 50); scene.add(sun); const fog = new THREE.Fog(0x87ceeb, 10, 200); scene.fog = fog; }

// Scene
const scene = new THREE.Scene();

// Camera - perspective for first-person
const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(0, 1.6, 0);

// Renderer
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;

// Light - ambient so we can see everything (low-poly style)
const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
scene.add(ambientLight);

// Directional light - sun
const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
directionalLight.position.set(50, 100, 50);
directionalLight.castShadow = true;
scene.add(directionalLight);

// Sun helper for day/night cycle
const sun = new THREE.Object3D();
sun.position.set(50, 50, 50);
scene.add(sun);

// Fog for day/night atmosphere
const fog = new THREE.Fog(0x87ceeb, 10, 200);
scene.fog = fog;

// Pointer lock state
let pointerLocked = false;

// ----- AUDIO SYSTEM -----
let audioContext = null;
let footstepGain = null;
let lastFootstepTime = 0;
const footstepCooldown = 200; // ms between footsteps


function initAudio() {
  try {
    audioContext = new (window.AudioContext || window.webkitAudioContext)();
    footstepGain = audioContext.createGain();
    footstepGain.gain.value = 0.5;
    footstepGain.connect(audioContext.destination);
  } catch (e) {
    console.error('Web Audio API not supported', e);
  }
}

// ----- EXPORT -----
  windSound.loop = true;
  windSound.volume = 0.1;

function updateAmbientSounds() {
  const dayProgress = (gameTime % 2000) / 2000;
  const isDay = dayProgress > 0.2 && dayProgress < 0.8;

  if (isDay) {
    oceanSound.volume = 0.05;
    windSound.volume = 0.1;
  } else {
    oceanSound.volume = 0.1;
    windSound.volume = 0.05;
  }

if (!oceanSound.paused) oceanSound.volume = Math.min(oceanSound.volume, 0.5);
  if (!windSound.paused) windSound.volume = Math.min(windSound.volume, 0.5);

  oceanSound.currentTime = 0;
  windSound.currentTime = 0;
}
  grass: { color: '#228b22', lowpassFreq: 800, gain: 0.5 },
  dirt: { color: '#8b4513', lowpassFreq: 600, gain: 0.6 },
  rock: { color: '#b87333', lowpassFreq: 400, gain: 0.4 },
  sand: { color: '#f4e0c5', lowpassFreq: 700, gain: 0.5 },
  wood: { color: '#8b4513', lowpassFreq: 500, gain: 0.5 },
  metal: { color: '#b87333', lowpassFreq: 300, gain: 0.3 },
  default: { lowpassFreq: 700, gain: 0.5 }
};

// Ambient sound elements
let oceanSound = null;
let windSound = null;
const oceanUrl = 'data:audio/wav;base64,UklGRiQAAABXRVMBAAAAABAAEAQDABAAZGF0YZ8aK5R0dHaAAAAAAAAAAAAAAAAAAAAAAAAAAA';
const windUrl = 'data:audio/wav;base64,UklGRiQAAABXRVMBAAAAABAAEAqdABAAZGF0YZ8aK5x0dHaAAAAAAAAAAAAAAAAAAAAAAAAAAA';

// Material colors for footstep sound filtering
const materialPresets = {
  grass: { color: #228b22, lowpassFreq: 800, gain: 0.5 },
  dirt: { color: #8b4513, lowpassFreq: 600, gain: 0.6 },
  rock: { color: #b87333, lowpassFreq: 400, gain: 0.4 },
  sand: { color: #f4e0c5, lowpassFreq: 700, gain: 0.5 },
  wood: { color: #8b4513, lowpassFreq: 500, gain: 0.5 },
  metal: { color: #b87333, lowpassFreq: 300, gain: 0.3 },
  default: { lowpassFreq: 700, gain: 0.5 }
}

function createFootstepOscillator(freq, gainValue, duration) {
  const oscillator = audioContext.createOscillator();
  const gainNode = audioContext.createGain();
  oscillator.type = 'sine';
  oscillator.frequency.value = freq;
  gainNode.gain.value = gainValue;
  oscillator.connect(gainNode);
  gainNode.connect(footstepGain);

  // Short decay
  const now = audioContext.currentTime;
  gainNode.gain.setValueAtTime(gainValue, now);
  gainNode.gain.exponentialRampToValueAtTime(0.001, now + duration);

  oscillator.start(now);
  oscillator.stop(now + duration);
}

function playFootstep(materialType) {
  if (!audioContext || !footstepGain) return;
  const now = audioContext.currentTime;
  if (now - lastFootstepTime < footstepCooldown / 1000) return;
  lastFootstepTime = now * 1000;

  const preset = materialPresets[materialType] || materialPresets.default;
  const baseFreq = 200 + Math.random() * 100;
  const freq = baseFreq * (0.8 + Math.random() * 0.4);

  // Create a short noise burst for more natural footstep
  const bufferSize = audioContext.sampleRate * 0.1;
  const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < bufferSize; i++) {
    data[i] = Math.random() * 2 - 1;
  }
  const noise = audioContext.createBufferSource();
  noise.buffer = buffer;
  noise.connect(footstepGain);
  noise.start(now);
  noise.stop(now + 0.1);

  // Also add a tonal component
  createFootstepOscillator(freq, preset.gain * 0.3, 0.2);
}

// Terrain material detection under player feet
function getFootstepMaterial(x, z) {
  const positions = terrainGeometry.attributes.position.array;
  if (!positions) return 'default';
  const gridSize = 50;
  const vertexX = Math.round((x + terrainSize / 2) / (terrainSize / gridSize)) % gridSize;
  const vertexZ = Math.round((z + terrainSize / 2) / (terrainSize / gridSize)) % gridSize;
  const idx = (vertexZ * gridSize + vertexX) * 3;
  if (idx >= 0 && idx + 2 < positions.length) {
    const y = positions[idx + 1];
    // Determine material based on height relative to terrain avg
    // Simple heuristic: lower areas = grass, higher = rock/sand
    if (y > 10) return 'rock';
    if (y > 5) return 'dirt';
    return 'grass';
  }
  return 'default';
}

// Footstep trigger on each animation frame when moving
let lastPlayerY = playerY;

function checkFootstep() {
  if (!pointerLocked || !audioContext) return;
  const moveSpeed = isSprinting ? SPRINT_MULTIPLIER * SPEED : SPEED;
  const hasMoved = Math.abs(camera.position.x - lastPlayerY) > 0.1 || Math.abs(camera.position.z - lastPlayerY) > 0.1;
  // Simplified: check if player moved significantly this frame
  if (hasMoved) {
    const material = getFootstepMaterial(camera.position.x, camera.position.z);
    playFootstep(material);
  }
  lastPlayerY = camera.position.y;
}

// ----- AMBIENT SOUND SYSTEM -----
let ambientOscillator = null;
let windOscillator = null;
let ambientPlaying = false;
let windPlaying = false;
let lastWindChange = 0;

function initAmbientSounds() {
  if (!audioContext) return;
  
  // Ocean ambience - low periodic waveform
  if (!ambientOscillator) {
    const oceanNode = audioContext.createOscillator();
    const oceanGain = audioContext.createGain();
    oceanNode.frequency.value = 0.2;
    oceanNode.type = 'triangle';
    oceanGain.gain.value = 0.1;
    oceanNode.connect(oceanGain);
    oceanGain.connect(footstepGain);
    oceanNode.start();
    ambientOscillator = oceanGain;
  }
  
  // Wind - noise burst with lowpass filter
  if (!windOscillator) {
    const windNode = audioContext.createBufferSource();
    const bufferSize = audioContext.sampleRate * 0.5;
    const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = Math.random() * 2 - 1;
    }
    windNode.buffer = buffer;
    windNode.loop = true;
    const windGain = audioContext.createGain();
    windGain.gain.value = 0.05;
    // Lowpass filter for windy sound
    const lastTime = audioContext.currentTime;
    windGain.gain.setValueAtTime(0.05, lastTime);
    windGain.gain.exponentialRampToValueAtTime(0.001, lastTime + 10);
    windNode.connect(windGain);
    windGain.connect(footstepGain);
    windNode.start();
    windOscillator = windGain;
  }
}

function updateAmbientSounds() {
  if (!audioContext) return;
  const now = audioContext.currentTime;
  
  // Ocean pitch varies slowly with time of day
  if (ambientOscillator) {
    const dayProgress = (gameTime * 0.001) % (2 * Math.PI);
    const isDay = dayProgress > 0.2 && dayProgress < 0.8;
    const baseFreq = isDay ? 0.15 : 0.08;
    ambientOscillator.frequency.value = baseFreq + Math.random() * 0.02;
  }
  
  // Wind changes periodically
  if (windOscillator && now - lastWindChange > 3) {
    if (windOscillator.context) {
      windOscillator.gain.gain.value = 0.02 + Math.random() * 0.03;
    }
    lastWindChange = now;
  }
}

document.body.addEventListener('click', () => {
  if (!pointerLocked) {
    canvas.requestPointerLock();
    initAmbientSounds();
  }
});

document.addEventListener('pointerlockchange', () => {
  pointerLocked = document.pointerLockElement === canvas;
});

document.addEventListener('pointerlockerror', (err) => {
  console.error('Pointer lock error:', err.message);
});

const moveDirection = new THREE.Vector3();
const velocity = new THREE.Vector3(0, 0, 0);
const SPEED = 0.2;
const SPRINT_MULTIPLIER = 1.5;
let isSprinting = false;

const onKeyDown = (event) => {
  switch (event.code) {
    case 'KeyW': moveDirection.z -= 1; break;
    case 'KeyS': moveDirection.z += 1; break;
    case 'KeyA': moveDirection.x -= 1; break;
    case 'KeyD': moveDirection.x += 1; break;
    case 'ShiftLeft': isSprinting = true; break;
    case 'Space': 
      if (canJump) { velocity.y = 0.4; canJump = false; }
      break;
    case 'KeyE': gatherResource(); break;
  }
};

const onKeyUp = (event) => {
  switch (event.code) {
    case 'KeyW': moveDirection.z += Math.abs(moveDirection.z); break;
    case 'KeyS': moveDirection.z -= Math.abs(moveDirection.z); break;
    case 'KeyA': moveDirection.x += Math.abs(moveDirection.x); break;
    case 'KeyD': moveDirection.x -= Math.abs(moveDirection.x); break;
    case 'ShiftLeft': isSprinting = false; break;
  }
};

document.addEventListener('keydown', onKeyDown);
document.addEventListener('keyup', onKeyUp);

// Mouse look
const rotation = new THREE.Euler();
let mouseSensitivity = 0.002;

document.addEventListener('mousemove', (event) => {
  if (!pointerLocked) return;
  rotation.y -= event.movementX * mouseSensitivity;
  rotation.x -= event.movementY * mouseSensitivity;
  rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, rotation.x));
});

// Jump state
let canJump = true;

// ----- RESOURCE SYSTEM -----
const resources = [];
const MAX_RESOURCES = 200;

const treeTypes = [
  { name: 'oak', color: '#8b4513', height: 20 },
  { name: 'pine', color: '#2c5f2d', height: 18 },
  { name: 'birch', color: '#e0e0e0', height: 15 },
];

const rockTypes = [
  { name: 'rock', color: '#b87333', size: 8 },
];

const oreTypes = [
  { name: 'copper', color: '#b87333', size: 5 },
  { name: 'iron', color: '#da825a', size: 5 },
  { name: 'silver', color: '#c0c0c0', size: 5 },
];

// ----- TERRAIN -----
const terrainSize = 500;
const terrainGeometry = new THREE.PlaneGeometry(terrainSize, terrainSize, 50, 50);
terrainGeometry.rotateX(-Math.PI / 2);

const terrainVertices = terrainGeometry.attributes.position.array;
for (let i = 0; i < terrainVertices.length; i += 3) {
  terrainVertices[i + 1] = terrainVertices[i + 1] + (Math.random() - 0.5) * 20;
}

const terrainMaterial = new THREE.MeshStandardMaterial({ color: '#8b5a2b', flatShading: true });
const terrain = new THREE.Mesh(terrainGeometry, terrainMaterial);
terrain.receiveShadow = true;
scene.add(terrain);

const groundHelper = new THREE.Mesh(
  new THREE.PlaneGeometry(20, 20),
  new THREE.MeshBasicMaterial({ color: 0x00ff00, opacity: 0.1, transparent: true })
);
groundHelper.position.y = 0.001;
groundHelper.rotateX(-Math.PI / 2);
scene.add(groundHelper);

// ----- RESOURCE CREATION -----
function createTrees() {
  const treeCount = 50;
  for (let i = 0; i < treeCount; i++) {
    const treeData = treeTypes[Math.floor(Math.random() * treeTypes.length)];
    const angle = (Math.random() * Math.PI * 2);
    const distance = 80 + Math.random() * 200;
    const x = Math.cos(angle) * distance;
    const z = Math.sin(angle) * distance;
    
    const trunkGeometry = new THREE.CylinderGeometry(1, 2, treeData.height, 8, 1, true);
    const trunk = new THREE.Mesh(trunkGeometry, new THREE.MeshStandardMaterial({ color: treeData.color, flatShading: true }));
    trunk.position.set(x, treeData.height / 2, z);
    trunk.castShadow = true;
    scene.add(trunk);
    
    const leafGeometry = new THREE.SphereGeometry(treeData.height * 0.6, 12, 12);
    const leaves = new THREE.Mesh(leafGeometry, new THREE.MeshBasicMaterial({ color: 0x228b22, transparent: true, opacity: 0.8 }));
    leaves.position.set(x, treeData.height + 2, z);
    scene.add(leaves);
    
    resources.push({
      id: `tree_${i}`, type: 'wood', maxAmount: 10, currentAmount: 10,
      position: { x, z }, node: trunk, gathered: false,
    });
  }
}

function createRocks() {
  const rockCount = 30;
  for (let i = 0; i < rockCount; i++) {
    const rockData = rockTypes[Math.floor(Math.random() * rockTypes.length)];
    const angle = (Math.random() * Math.PI * 2);
    const distance = 100 + Math.random() * 250;
    const x = Math.cos(angle) * distance;
    const z = Math.sin(angle) * distance;
    
    const rockGeometry = new THREE.IcosahedronGeometry(rockData.size, 0);
    const rock = new THREE.Mesh(rockGeometry, new THREE.MeshStandardMaterial({ color: rockData.color, flatShading: true }));
    rock.position.set(x, rockData.size, z);
    rock.castShadow = true;
    scene.add(rock);
    
    resources.push({
      id: `rock_${i}`, type: 'stone', maxAmount: 5, currentAmount: 5,
      position: { x, z }, node: rock, gathered: false,
    });
  }
}

function createOres() {
  const oreCount = 20;
  for (let i = 0; i < oreCount; i++) {
    const oreData = oreTypes[Math.floor(Math.random() * oreTypes.length)];
    const angle = (Math.random() * Math.PI * 2);
    const distance = 120 + Math.random() * 300;
    const x = Math.cos(angle) * distance;
    const z = Math.sin(angle) * distance;
    
    const oreGeometry = new THREE.SphereGeometry(oreData.size, 12, 12);
    const oreMesh = new THREE.Mesh(oreGeometry, new THREE.MeshStandardMaterial({ color: oreData.color, flatShading: true }));
    oreMesh.position.set(x, oreData.size, z);
    oreMesh.castShadow = true;
    scene.add(oreMesh);
    
    resources.push({
      id: `ore_${i}`, type: 'metal', maxAmount: 3, currentAmount: 3,
      position: { x, z }, node: oreMesh, gathered: false,
    });
  }
}

createTrees();
createRocks();
createOres();

// ----- GATHERING SYSTEM -----
let canGather = true;
let lastGatherTime = 0;
const gatherCooldown = 500;

function gatherResource() {
  if (!pointerLocked || !canGather) return;
  const now = Date.now();
  if (now - lastGatherTime < gatherCooldown) return;
  
  const raycaster = new THREE.Raycaster();
  const dir = new THREE.Vector3();
  camera.getWorldDirection(dir);
  raycaster.set(camera.position, dir);
  raycaster.far = 5;
  
  const intersects = raycaster.intersectObjects(resources.filter(r => !r.gathered), true);
  
  if (intersects.length > 0) {
    let resourceData = null;
    for (const r of resources) {
      if (r.node === intersects[0].object || (r.node && r.node.parent === intersects[0].object)) {
        resourceData = r;
        break;
      }
    }
    
    if (resourceData && resourceData.currentAmount > 0) {
      resourceData.currentAmount--;
      console.log(`Gathered ${resourceData.type}, remaining: ${resourceData.currentAmount}/${resourceData.maxAmount}`);
      
      intersected.scale.set(1.1, 1.1, 1.1);
      setTimeout(() => { intersected.scale.set(1, 1, 1); }, 50);
      
      lastGatherTime = now;
      
      if (resourceData.currentAmount <= 0) {
        resourceData.gathered = true;
        setTimeout(() => {
          const idx = resources.indexOf(resourceData);
          if (idx > -1) resources.splice(idx, 1);
        }, 1000);
      }
    }
  }
}

// ----- PLAYER POSITION & PHYSICS -----
const groundLevel = 0;
let playerX = 0, playerZ = 0, playerY = 1.6;
const gravity = -0.005;

function getTerrainHeight(x, z) {
  const positions = terrainGeometry.attributes.position.array;
  if (!positions) return groundLevel;
  const gridSize = 50;
  const vertexX = Math.round((x + terrainSize / 2) / (terrainSize / gridSize)) % gridSize;
  const vertexZ = Math.round((z + terrainSize / 2) / (terrainSize / gridSize)) % gridSize;
  const idx = (vertexZ * gridSize + vertexX) * 3;
  if (idx >= 0 && idx + 2 < positions.length) return positions[idx + 1];
  return groundLevel;
}

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

// ----- RENDER LOOP -----
let frame = 0, gameTime = 0;
function animate() {
  requestAnimationFrame(animate);

  if (pointerLocked) {
    camera.rotation.y = rotation.y;
    camera.rotation.x = rotation.x;
    
    const moveSpeed = isSprinting ? SPRINT_MULTIPLIER * SPEED : SPEED;
    const angle = camera.rotation.y;
    const forwardX = Math.sin(angle), forwardZ = Math.cos(angle);
    const rightX = Math.sin(angle + Math.PI / 2), rightZ = Math.cos(angle + Math.PI / 2);
    
    if (moveDirection.z !== 0 || moveDirection.x !== 0) {
      velocity.x = (forwardX * moveDirection.z + rightX * moveDirection.x) * moveSpeed;
      velocity.z = (forwardZ * moveDirection.z + rightZ * moveDirection.x) * moveSpeed;
    } else {
      velocity.x *= 0.95;
      velocity.z *= 0.95;
    }
    
    velocity.y += gravity;
    const targetY = playerY + velocity.y;
    const terrainHeight = getTerrainHeight(camera.position.x, camera.position.z);
    
    if (targetY < terrainHeight + 2.0) {
      velocity.y = terrainHeight + 2.0 - playerY;
      canJump = true;
    }
    
    playerY += velocity.y;
    camera.position.y = playerY;
    camera.position.x += velocity.x;
    camera.position.z += velocity.z;
    
    const minX = -terrainSize / 2 + 20, maxX = terrainSize / 2 - 20;
    const minZ = -terrainSize / 2 + 20, maxZ = terrainSize / 2 - 20;
    if (camera.position.x < minX) camera.position.x = minX;
    if (camera.position.x > maxX) camera.position.x = maxX;
    if (camera.position.z < minZ) camera.position.z = minZ;
    if (camera.position.z > maxZ) camera.position.z = maxZ;
  }

  // Footstep sound effect
  if (pointerLocked) {
    const moveSpeed = isSprinting ? SPRINT_MULTIPLIER * SPEED : SPEED;
    const hasMoved = moveSpeed > 0.05;
    if (hasMoved) {
      const material = getFootstepMaterial(camera.position.x, camera.position.z);
      playFootstep(material);
    }
  }

  updateAmbientSounds();

  // FPS counter calculation
  fpsFrames++;
  if (gameTime - fpsTime > 1000) {
    fps = fpsFrames;
    fpsFrames = 0;
    fpsTime = gameTime;
    if (fpsToggle) {
      fpsToggle.textContent = `${fps} FPS`;
      fpsToggle.style.display = pointerLocked ? 'block' : 'none';
    }
  }

  gameTime++;
  const timeProgress = gameTime * 0.001;
  sun.position.x = 50 * Math.cos(timeProgress * 0.2);
  sun.position.z = 50 * Math.sin(timeProgress * 0.2);
  sun.position.y = 50 * Math.sin(timeProgress * 0.15);
  
  const dayProgress = (timeProgress % (2 * Math.PI)) / (2 * Math.PI);
  const isDay = dayProgress > 0.2 && dayProgress < 0.8;
  
  if (isDay) {
    skyColor.setRGB(0.5 + 0.5 * Math.sin(timeProgress * 2), 0.7 + 0.3 * Math.sin(timeProgress * 2 - 1), 1.0);
    fog.density = 0.02;
  } else {
    skyColor.setRGB(0.02, 0.02, 0.08);
    fog.density = 0.05;
  }
  
  renderer.setClearColor(skyColor);

  // Resource respawning
  resources.forEach(r => {
    if (r.gathered && r.currentAmount < r.maxAmount) {
      r.currentAmount = Math.min(r.maxAmount, r.currentAmount + 0.01);
    }
  });

  // ----- GATHERING PROMPT LOGIC -----
  const raycaster = new THREE.Raycaster();
  const dir = new THREE.Vector3();
  camera.getWorldDirection(dir);
  raycaster.set(camera.position, dir);
  raycaster.far = 5;
  
  const gatherable = resources.filter(r => !r.gathered && r.currentAmount > 0);
  const intersects = raycaster.intersectObjects(gatherable, true);
  if (intersects.length > 0) {
    gatherPrompt.style.display = 'block';
  } else {
    gatherPrompt.style.display = 'none';
  }

  // Reduce attack cooldown each frame
  if (attackCooldown > 0) {
    attackCooldown -= 1 / 60;
  }
  
  renderer.render(scene, camera);
}

const skyColor = new THREE.Color(0x87ceeb);
animate();

