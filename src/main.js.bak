// ----- WILDLIFE AI SYSTEM -----
// Simple distance-based AI for wildlife entities
const wildlife = [];

function createWildlife(x, z, type) {
  const sizes = { deer: 4, boar: 6, wolf: 5 };
  const speed = { deer: 1.5, boar: 1.0, wolf: 2.0 };
  
  const geometry = new THREE.SphereGeometry(sizes[type], 12, 12);
  const materials = { deer: new THREE.MeshStandardMaterial({ color: '#6b4c4c', flatShading: true }),
                     boar: new THREE.MeshStandardMaterial({ color: '#8b4513', flatShading: true }),
                     wolf: new THREE.MeshStandardMaterial({ color: '#2c5f2d', flatShading: true }) };
  
  const mesh = new THREE.Mesh(geometry, materials[type]);
  mesh.position.set(x, sizes[type], z);
  mesh.castShadow = true;
  mesh.userData = { type, health: 3, maxHealth: 3, speed: speed[type] };
  scene.add(mesh);
  
  wildlife.push({
    mesh,
    type,
    position: { x, z },
    targetX: x, targetZ: z,
    state: 'idle',
    timer: 0,
    wanderRadius: 30
  });
}

// Initialize wildlife
createWildlife(100, 100, 'deer');
createWildlife(-80, 150, 'boar');
createWildlife(200, -100, 'wolf');

// Simple AI update - called within the render loop
function updateWildlifeAI(deltaTime) {
  if (!pointerLocked) return;
  
  const playerPos = { x: camera.position.x, z: camera.position.z };
  
  wildlife.forEach(entity => {
    const distX = Math.abs(entity.position.x - playerPos.x);
    const distZ = Math.abs(entity.position.z - playerPos.z);
    const distance = Math.sqrt(distX * distX + distZ * distZ);
    
    // State transitions based on distance
    if (distance < 30) {
      // Too close - flee
      entity.state = 'fleeing';
    } else if (distance < 100) {
      // Notice player - chase
      entity.state = 'chasing';
      // Move toward player
      entity.targetX = playerPos.x;
      entity.targetZ = playerPos.z;
    } else {
      // Wander or idle
      entity.state = 'wandering';
      
      // Wander timer
      entity.timer += deltaTime;
      if (entity.timer > 2) {
        entity.timer = 0;
        // Random new wander point
        const angle = Math.random() * Math.PI * 2;
        entity.targetX = entity.position.x + Math.cos(angle) * entity.wanderRadius;
        entity.targetZ = entity.position.z + Math.sin(angle) * entity.wanderRadius;
      }
    }
    
    // Move toward target
    const target = entity.targetX;
    const dx = entity.position.x < target ? entity.userData.speed * deltaTime : 
               entity.position.x > target ? -entity.userData.speed * deltaTime : 0;
    entity.position.x += dx;
    
    const dz = entity.position.z < target ? entity.userData.speed * deltaTime :
               entity.position.z > target ? -entity.userData.speed * deltaTime : 0;
    entity.position.z += dz;
    
    // Update mesh position
    entity.mesh.position.set(entity.position.x, entity.userData.maxHealth, entity.position.z);
    
    // Reset if far away (performance)
    if (distance > 200) {
      entity.position.x = entity.mesh.position.x = 100 + Math.random() * 200;
      entity.position.z = entity.mesh.position.z = 100 + Math.random() * 200;
    }
  });
}

// ----- BUILDING SYSTEM -----
let selectedBuilding = null;
const GRID_SIZE = 10;
let placementValid = true;

const buildingTypes = {
  foundation: { size: 20, resourceCost: { wood: 5 } },
  wall: { size: 2, resourceCost: { wood: 3 } },
  floor: { size: 20, resourceCost: { wood: 10 } }
};

function canAffordResources(cost) {
  // Simple check - always return true for now
  return true;
}

function placeBuilding(type) {
  if (!canAffordResources(buildingTypes[type].resourceCost)) {
    console.log("Not enough resources");
    return;
  }
  console.log("Placing " + type);
  // Create the actual building mesh
  const geometry = new THREE.BoxGeometry(buildingTypes[type].size, 2, buildingTypes[type].size);
  const material = new THREE.MeshStandardMaterial({ color: '#8b5a2b', flatShading: true });
  const building = new THREE.Mesh(geometry, material);
  building.position.set(camera.position.x, 1, camera.position.z);
  building.castShadow = true;
  scene.add(building);
}

// Hotkey bindings for building selection
document.addEventListener('keydown', (event) => {
  if (event.code === 'Key1') selectedBuilding = 'foundation';
  if (event.code === 'Key2') selectedBuilding = 'wall';
  if (event.code === 'Key3') selectedBuilding = 'floor';
});
// ----- SAVE/LOAD SYSTEM -----
const SAVE_VERSION = 1;

function saveGame() {
  const gameState = {
    version: SAVE_VERSION,
    seed: Math.floor(Math.random() * 100000), // Generate seed or store existing
    playerPosition: {
      x: camera.position.x,
      y: camera.position.y,
      z: camera.position.z
    },
    inventory: inventory.map(item => ({ ...item })),
    stats: {
      health: 100,
      hunger: 100,
      thirst: 100,
      stamina: 100
    },
    structures: [], // Would contain placed building data
    timeOfDay: gameTime * 0.001,
    resources: resources.map(r => ({
      id: r.id,
      type: r.type,
      currentAmount: r.currentAmount,
      maxAmount: r.maxAmount
    }))
  };
  
  localStorage.setItem('wildlands_save', JSON.stringify(gameState));
  console.log('Game saved');
}

function loadGame() {
  const saved = localStorage.getItem('wildlands_save');
  if (!saved) {
    console.log('No save file found');
    return false;
  }
  
  const gameState = JSON.parse(saved);
  
  if (gameState.version !== SAVE_VERSION) {
    console.log('Save version mismatch');
    return false;
  }
  
  // Restore player position
  if (gameState.playerPosition) {
    camera.position.set(
      gameState.playerPosition.x,
      gameState.playerPosition.y,
      gameState.playerPosition.z
    );
    playerY = gameState.playerPosition.y;
  }
  
  // Restore inventory
  if (gameState.inventory) {
    inventory = gameState.inventory.map(item => ({
      id: item.id,
      type: item.type,
      count: item.count || 1
    }));
    updateInventoryUI();
  }
  
  // Restore stats
  if (gameState.stats) {
    // Update HUD bars
    const hungerPercent = gameState.stats.hunger / 100;
    const thirstPercent = gameState.stats.thirst / 100;
    if (document.getElementById('hunger-bar')) {
      document.getElementById('hunger-bar').style.width = `${hungerPercent * 100}%`;
    }
    if (document.getElementById('thirst-bar')) {
      document.getElementById('thirst-bar').style.width = `${thirstPercent * 100}%`;
    }
  }
  
  console.log('Game loaded');
  return true;
}

function newGame() {
  // Clear save and restart
  localStorage.removeItem('wildlands_save');
  // Reset player to starting position
  camera.position.set(0, 1.6, 0);
  playerY = 1.6;
  console.log('New game started');
}

// Hotkey F2 to save, F3 to toggle FPS counter
document.addEventListener('keydown', (event) => {
  if (event.code === 'F2') saveGame();
  if (event.code === 'F3') {
    if (fpsToggle) {
      fpsToggle.style.display = fpsToggle.style.display === 'none' ? 'block' : 'none';
    }
  }
  if (event.code === 'Escape') closeInventory();
});

// Update inventory UI from saved state
function updateInventoryUI() {
  const slots = document.querySelectorAll('#inventory-panel .slot');
  inventory.forEach((item, index) => {
    if (index < slots.length) {
      if (item.type) {
        slots[index].innerText = item.type.substring(0, 4).toUpperCase();
        slots[index].style.background = getItemColor(item.type);
      } else {
        slots[index].innerText = '';
        slots[index].style.background = '#3a3a4a';
      }
    }
  });
}

// Helper: get color for resource type
function getItemColor(type) {
  const colors = {
    wood: '#8b4513',
    stone: '#b87333',
    metal: '#b87333'
  };
  return colors[type] || '#3a3a4a';
}
