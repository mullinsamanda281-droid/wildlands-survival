// ----- COMBAT SYSTEM -----
let isAttacking = false;
let attackCooldown = 0;
const attackSpeed = 0.5; // seconds
const meleeDamage = 10;
const bowDamage = 5;
const bowRange = 10;

function dealDamage(target, damage) {
  if (!target) return 0;
  if (target.currentAmount !== undefined) {
    // Resource - reduce amount
    target.currentAmount = Math.max(0, target.currentAmount - damage);
    return target.currentAmount;
  }
  if (target.userData && target.userData.health !== undefined) {
    // Entity - reduce health
    target.userData.health = Math.max(0, target.userData.health - damage);
    return target.userData.health;
  }
  return 0;
}

function showDamageNumber(x, y, number, color) {
  const dmgText = document.createElement('div');
  dmgText.style.position = 'absolute';
  dmgText.style.left = x + 'px';
  dmgText.style.top = y + 'px';
  dmgText.style.color = color || '#ff4444';
  dmgText.style.fontSize = '14px';
  dmgText.style.fontFamily = 'Arial, sans-serif';
  dmgText.style.textShadow = '1px 1px 2px #000';
  dmgText.style.pointerEvents = 'none';
  dmgText.style.zIndex = '1002';
  dmgText.innerText = '+' + number;
  hud.appendChild(dmgText);
  // Remove after 0.5s
  setTimeout(() => { if (dmgText.parentNode) hud.removeChild(dmgText); }, 500);
}

function meleeAttack() {
  if (isAttacking || attackCooldown > 0) return;
  isAttacking = true;
  
  // Raycast from camera direction
  const raycaster = new THREE.Raycaster();
  const dir = new THREE.Vector3();
  camera.getWorldDirection(dir);
  raycaster.set(camera.position, dir);
  raycaster.far = 5;
  
  const intersects = raycaster.intersectObjects(resources.filter(r => !r.gathered), true);
  
  if (intersects.length > 0) {
    // Deal damage to the first resource hit
    const target = intersects[0].object;
    for (const r of resources) {
      if (r.node === target || (r.node && r.node.parent === target)) {
        const remaining = dealDamage(r, meleeDamage);
        console.log(`Melee hit ${r.type}, remaining: ${remaining}/${r.maxAmount}`);
        // Show damage number at cursor position
        const cursorX = (intersects[0].screenX / 2) + 0.5; // normalized to screen
        const cursorY = (-intersects[0].screenY / 2) + 0.5;
        const screenX = cursorX * window.innerWidth;
        const screenY = cursorY * window.innerHeight;
        showDamageNumber(screenX, screenY, meleeDamage, '#ff4444');
        break;
      }
    }
  }
  
  attackCooldown = attackSpeed;
  isAttacking = false;
}

function bowShot() {
  if (isAttacking || attackCooldown > 0) return;
  isAttacking = true;
  
  // Raycast from camera direction
  const raycaster = new THREE.Raycaster();
  const dir = new THREE.Vector3();
  camera.getWorldDirection(dir);
  raycaster.set(camera.position, dir);
  raycaster.far = bowRange;
  
  const intersects = raycaster.intersectObjects(resources.filter(r => !r.gathered), true);
  
  if (intersects.length > 0) {
    // Deal damage to the first resource hit
    const target = intersects[0].object;
    for (const r of resources) {
      if (r.node === target || (r.node && r.node.parent === target)) {
        const remaining = dealDamage(r, bowDamage);
        console.log(`Bow hit ${r.type}, remaining: ${remaining}/${r.maxAmount}`);
        // Show damage number at cursor position
        const cursorX = (intersects[0].screenX / 2) + 0.5;
        const cursorY = (-intersects[0].screenY / 2) + 0.5;
        const screenX = cursorX * window.innerWidth;
        const screenY = cursorY * window.innerHeight;
        showDamageNumber(screenX, screenY, bowDamage, '#5dade2');
        break;
      }
    }
  }
  
  attackCooldown = attackSpeed * 2; // Bow has longer cooldown
  isAttacking = false;
}

document.addEventListener('mousedown', (event) => {
  if (!pointerLocked) return;
  if (event.button === 0) {
    // Left mouse - melee attack
    meleeAttack();
  }
  if (event.button === 2) {
    // Right mouse - bow shot
    bowShot();
  }
});

